rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users can only read/write their own profile document and all of their personal subcollections (symptoms, visits, vault, vitals, meds, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other documents outside users directory
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
